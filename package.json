{
  "name": "mealplan-card",
  "version": "1.0.0",
  "main": "dist/mealplan-card.js",
  "description": "MealPlan Card for Home Assistant",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "version:update": "node scripts/update-version.js",
    "build": "vite build",
    "supported": "node scripts/generate-manufacturer-list.mjs > SUPPORTED.md",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && biome ci .",
    "lint:fix": "tsc --noEmit && biome check --write ."
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@biomejs/biome": "^2.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@kipk/load-ha-components": "^2.1.0",
    "@open-wc/semantic-dom-diff": "^0.21.0"
  }
}
