{
"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
"vcs": {
"enabled": true,
"clientKind": "git",
"useIgnoreFile": true
},
"files": {
"ignoreUnknown": false,
"includes": [
"**",
"!dist",
"!coverage",
"!run"
]
},
"formatter": {
"enabled": true,
"indentStyle": "space",
"indentWidth": 2,
"lineWidth": 80
},
"javascript": {
"formatter": {
"quoteStyle": "single",
"jsxQuoteStyle": "single",
"semicolons": "always"
}
},
"linter": {
"enabled": true,
"rules": {
"recommended": true,
"style": {
"noVar": "error",
"useConst": "error",
"noNonNullAssertion": "off"
},
"suspicious": {
"noDebugger": "error",
"noExplicitAny": "warn",
"noDoubleEquals": "error",
"noEval": "error",
"noFunctionAssign": "error"
},
"correctness": {
"noUnusedVariables": "error"
}
}
},
"assist": {
"actions": {
"source": {
"organizeImports": "on"
}
}
}
}
